# ---------------- SCENES ----------------

scene1 = Scene(
    "Scene 1",
    "You have awakened in a dark mansion. Do you go forward?",
    mansion_art,
    ["Go to hallway", "Stay here"]
)

scene2 = Scene(
    "Scene 2",
    "You walk into a dark hallway. It gets even darker. Continue?",
    hallway_art,
    ["Keep walking", "Look around in the dark"]
)

scene3 = Scene(
    "Scene 3",
    "You see a glistening object. Pick it up?",
    randomObject_art,
    ["Pick it up", "Leave it"]
)

scene4 = Scene(
    "Scene 4",
    "It's a lantern. Use it?",
    randomObject_art,
    ["Light the candle", "Leave it"]
)

scene5 = Scene(
    "Scene 5",
    "With light, you see a strange mirror.",
    mirror_art,
    ["Look into the mirror", "You dont have a choice here"]
)


# ---------------- SAVE FUNCTION ----------------

JUMPSCARE_VIDEO_LINK = "https://www.youtube.com/watch?v=ywthKNqI7uI"

def save_result(player_name, ending, choices_made):
    with open("story_result.txt", "w", encoding="utf-8") as file:
        file.write("Horror Adventure Story Result\n")
        file.write("================================\n\n")

        file.write("Player Name: " + player_name + "\n")
        file.write("Ending: " + ending + "\n\n")

        file.write("Choices Made:\n")
        for choice in choices_made:
            file.write("- " + choice + "\n")

        file.write("\nJump-Scare Video Link:\n")
        file.write(JUMPSCARE_VIDEO_LINK + "\n")

    print("\nYour result has been saved to story_result.txt")


# ---------------- GAME ----------------

choices_made = []

def play_story():
    global choices_made
    choices_made = []

    name = input("What is your name? ")
    print("Welcome,", name)

    current_scene = scene1

    while True:
        current_scene.display()
        choice = input("> ")

        # SCENE 1
        if current_scene == scene1:
            if choice == "1":
                choices_made.append("Went to hallway")
                current_scene = scene2
            elif choice == "2":
                print("Darkness consumes you.")
                break
            else:
                print("Invalid choice.")

        # SCENE 2
        elif current_scene == scene2:
            if choice == "1":
                print("You walk into darkness and vanish.")
                break
            elif choice == "2":
                choices_made.append("Looked into dark")
                current_scene = scene3
            else:
                print("Invalid choice.")

        # SCENE 3
        elif current_scene == scene3:
            if choice == "1":
                choices_made.append("Picked up object")
                current_scene = scene4
            elif choice == "2":
                print("You leave it. Darkness consumes you.")
                break
            else:
                print("Invalid choice.")

        # SCENE 4
        elif current_scene == scene4:
            if choice == "1":
                choices_made.append("Used lantern")
                current_scene = scene5
            elif choice == "2":
                print("Without light, darkness consumes you.")
                break
            else:
                print("Invalid choice.")

        # SCENE 5
        elif current_scene == scene5:
            if choice == "1":
                print("You look into the mirror... something looks back.")
                print("THE END.")
            elif choice == "2":
                print("You hesitate… but something forces you to look anyway.")
                print("THE END.")
            else:
                print("Invalid choice.")
                continue
            break

    # FIXED FUNCTION CALL
    save_result(name, "Game Over", choices_made)


# ---------------- START LOOP ----------------

while True:
    play_story()
    again = input("\nPlay again? (y/n): ").lower()
    if again != "y":
        print("Goodbye!")
        break
